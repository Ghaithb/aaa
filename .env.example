# ── DATABASE ──────────────────────────────────────────────
DATABASE_URL="postgresql://ferha_user:ferha_password@localhost:5432/ferha_db"
DATABASE_URL_TEST="postgresql://ferha_user:ferha_password@localhost:5432/ferha_test"

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_64_CHAR_SECRET_HERE"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_64_CHAR_REFRESH_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# ── APP ───────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3001"

# ── UPLOADS ───────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# ── MINIO (stockage images local) ─────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minio_access_key"
MINIO_SECRET_KEY="minio_secret_key"
MINIO_BUCKET="ferha-media"

# ── RATE LIMITING ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60
